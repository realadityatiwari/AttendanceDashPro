# ────────────────────────────────────────────────────────────────────────
# AttendanceDash Pro — Reverse Proxy (Caddy 2)
#
# Phase 18A: HTTP-only routing. TLS/HTTPS will be provisioned in a later
# phase by replacing `http://` with the domain name on the site address.
#
# Routing:
#   /api/*  → backend:8000  (FastAPI, with X-Forwarded-For preserved)
#   *       → frontend:3000  (Next.js SSR + PWA)
#
# Proxy trust boundary (Phase 18B):
#   Caddy is the ONLY trusted external proxy. It automatically sets
#   X-Forwarded-For to the original client IP for every proxied request.
#   The backend trusts X-Forwarded-For ONLY from the pinned proxy-net CIDR
#   (FORWARDED_ALLOW_IPS, default 172.28.0.0/24 — see docker-compose.prod.yml).
#   Client-supplied X-Forwarded-For headers from outside that subnet are
#   ignored by Uvicorn, so the Phase 16 rate limiter sees the real client IP.
# ────────────────────────────────────────────────────────────────────────

http://{$DOMAIN:app.example.com} {
    encode gzip

    # Health check endpoint → FastAPI backend (not proxied via frontend)
    handle /health {
        reverse_proxy backend:8000
    }

    # API requests → FastAPI backend
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Everything else → Next.js frontend (SSR + PWA)
    handle {
        reverse_proxy frontend:3000
    }
}
