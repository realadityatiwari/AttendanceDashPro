# AttendanceDash Pro — Production environment example (Phase 18B)
#
# Copy to `deploy/.env.prod` and fill in REAL values. NEVER commit real
# secrets. This example contains PLACEHOLDERS ONLY; `deploy/.env.prod` is
# gitignored.
#
# Usage:
#   docker compose -f docker-compose.prod.yml --env-file deploy/.env.prod up -d
#
# Required variables use `${VAR:?}` in docker-compose.prod.yml — compose
# fails fast (instead of silently using empty values) when they are missing.

# ── REQUIRED ────────────────────────────────────────────────────────────

# PostgreSQL (private, inside the Docker network)
POSTGRES_USER=change-me-db-user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=attendancedash

# Backend JWT signing secret (>= 20 chars; the Phase 17 guard rejects the
# development default and short secrets when APP_ENV=production).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-64-hex-random

# CORS: the public frontend origin(s) the browser uses. JSON list.
BACKEND_CORS_ORIGINS=["https://app.example.com"]

# Frontend public API base URL. NEXT_PUBLIC_* variables are intentionally
# PUBLIC — Next.js inlines them into the client bundle at build time.
NEXT_PUBLIC_API_URL=https://app.example.com

# ── OPTIONAL (sensible defaults exist in docker-compose.prod.yml) ───────

# Proxy trust boundary: CIDR(s) Uvicorn trusts for X-Forwarded-For.
# MUST match PROXY_NET_SUBNET below (default 172.28.0.0/24).
FORWARDED_ALLOW_IPS=172.28.0.0/24
# PROXY_NET_SUBNET=172.28.0.0/24

# Direct DB URI override (default: built from POSTGRES_* + postgres:5432).
# Use only if DATABASE_URI differs from the compose default (e.g. managed DB).
# DATABASE_URI=postgresql+asyncpg://user:pass@postgres:5432/attendancedash

# ── Backup (Phase 18C) ──────────────────────────────────────────────────
# Backup interval in seconds (default 86400 = daily).
BACKUP_INTERVAL=86400
# Number of local backup files to retain (default 14).
BACKUP_RETENTION_COUNT=14
# Off-host protection: set OFFHOST_TYPE to enable off-host backup copy.
# Supported types: none (default), mount, sftp, s3, custom.
# OFFHOST_TYPE= mount
# OFFHOST_DEST= /mnt/backups
# OFFHOST_CMD=  (for custom type)

# ── Backend configuration ───────────────────────────────────────────────
APP_ENV=production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
SECURITY_HSTS_ENABLED=false
UVICORN_WORKERS=1

# Reverse proxy hostname (no real domain until TLS phase — Phase 18D)
DOMAIN=app.example.com
