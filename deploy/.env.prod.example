# AttendanceDash Pro — Production environment example (Phase 18A)
#
# Copy to `deploy/.env.prod` and fill in real values. NEVER commit real
# secrets. This file is gitignored; only this example is tracked.
#
# Usage:
#   docker compose -f docker-compose.prod.yml --env-file deploy/.env.prod up -d

# ── PostgreSQL (private, inside the Docker network) ─────────────────────
POSTGRES_USER=attendancedash
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=attendancedash

# ── Backend secrets / configuration ─────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-64-hex-random
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
APP_ENV=production
SECURITY_HSTS_ENABLED=false
UVICORN_WORKERS=1

# CORS: the public frontend origin(s) the browser uses.
BACKEND_CORS_ORIGINS=["https://app.example.com"]

# ── Frontend (public, inlined at build time) ────────────────────────────
NEXT_PUBLIC_API_URL=https://app.example.com

# ── Reverse proxy hostname (no real domain until TLS phase) ─────────────
DOMAIN=app.example.com
