DATABASE_URI=postgresql+asyncpg://postgres:postgres@localhost:55432/attendancedash
BACKEND_CORS_ORIGINS=["http://localhost:3100","http://127.0.0.1:3100"]

# --- Runtime environment (Phase 17) ---
# development (default) | production
# In production, JWT_SECRET_KEY MUST be a strong random secret (>= 20 chars)
# and MUST NOT be the development default; startup fails otherwise.
APP_ENV=development

# --- JWT (Phase 16) ---
# Production MUST set a strong random secret, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=supersecret_development_key_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Security headers (Phase 16) ---
# Enable HSTS ONLY when HTTPS is guaranteed in production (never on localhost).
SECURITY_HSTS_ENABLED=false

# --- Rate limiting (Phase 16) ---
# In-process limiter; for multi-process production deploy use a distributed
# limiter (Redis) — see Phase 17 dependencies.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900
REGISTER_MAX_ATTEMPTS=5
REGISTER_WINDOW_SECONDS=3600
