# ════════════════════════════════════════════════════════════════════════
# AttendanceDash Pro — Backend environment example
# ════════════════════════════════════════════════════════════════════════
#
# DEVELOPMENT values only. Copy to `backend/.env` and adjust for local work.
# This file is gitignored. NEVER put real production credentials here.
#
# PRODUCTION (Render Free Web Service, Phase 21D):
#   All values below are injected via Render environment variables — never
#   committed. See docs/phase_21/phase_21d0_free_beta_architecture.md and
#   docs/phase_21/phase_21d1_config_hardening.md.
# ════════════════════════════════════════════════════════════════════════

# ── Database (local dev: Docker postgres:16 on 55432) ──────────────────
# Production (Supabase Free): set DATABASE_URI to the Supabase connection
# string with the +asyncpg driver prefix, e.g.
#   postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URI=postgresql+asyncpg://postgres:postgres@localhost:55432/attendancedash

# ── CORS ────────────────────────────────────────────────────────────────
# Development: localhost origins.
# Production (Vercel): set BACKEND_CORS_ORIGINS to the exact Vercel
# production origin, e.g. ["https://<project>.vercel.app"].
BACKEND_CORS_ORIGINS=["http://localhost:3100","http://127.0.0.1:3100"]

# ── Runtime environment (Phase 17) ──────────────────────────────────────
# "development" (default) | "production"
# In production, startup fails if JWT_SECRET_KEY is the development default
# or shorter than 20 characters, or if DATABASE_URI references localhost,
# or if BACKEND_CORS_ORIGINS contains localhost.
APP_ENV=development

# ── JWT (Phase 16) ──────────────────────────────────────────────────────
# Production MUST set a strong random secret, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=supersecret_development_key_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Server port (Phase 21D.1) ───────────────────────────────────────────
# Render injects PORT at runtime; the Dockerfile defaults to 8000 when
# unset (local/Compose execution). No value needed here.
# PORT=8000

# ── Security headers (Phase 16) ─────────────────────────────────────────
# Enable HSTS ONLY when HTTPS is guaranteed in production (never on
# localhost). Render + Vercel both serve HTTPS, so production may set true.
SECURITY_HSTS_ENABLED=false

# ── Rate limiting (Phase 16) ────────────────────────────────────────────
# In-process limiter; for multi-process production deploy use a distributed
# limiter (Redis) — see Phase 17 dependencies.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900
REGISTER_MAX_ATTEMPTS=5
REGISTER_WINDOW_SECONDS=3600
