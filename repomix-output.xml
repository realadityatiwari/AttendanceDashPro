  --transition:  0.18s cubic-bezier(0.4,0,0.2,1);
}
[data-theme="light"] {
  --bg:          #f0f2f8;
  --surface:     #ffffff;
  --surface2:    #f6f7fc;
  --surface3:    #eceef6;
  --border:      rgba(0,0,0,0.07);
  --border2:     rgba(0,0,0,0.13);
  --text:        #111827;
