    max-width: 1200px;
  }

  .header h1 {
    font-size: 28px;
  }

  .subject-grid {
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 18px;
  }

  .subj-card {
    padding: 22px;
  }

  .hero-card {
    padding: 28px 32px;
  }

  .hero-val {
    font-size: 40px;
  }

  .stats-row {
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }

  table.att {
    font-size: 13px;
  }

  table.att td {
    padding: 14px 12px;
  }

  .today-classes-card {
    padding: 22px 24px;
  }
}

/* ─── Large Desktop (1440px+) ──────────────────────────────────────── */
@media (min-width: 1440px) {
  .shell {
    max-width: 1440px;
    padding-left: clamp(24px, 3vw, 40px);
    padding-right: clamp(24px, 3vw, 40px);
  }

  .header {
    padding: 40px 0 36px;
  }

  .header h1 {
    font-size: 32px;
  }

  .subject-grid {
    grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
    gap: 20px;
  }

  .subj-card {
    padding: 24px;
  }

  .subj-card-code {
    font-size: 15px;
  }

  .hero-card {
    padding: 32px 40px;
    border-radius: 16px;
  }

  .hero-val {
    font-size: 44px;
  }

  .hero-title {
    font-size: 20px;
  }

  .hero-item {
    min-width: 130px;
  }

  .hero-item-val {
    font-size: 20px;
  }

  .stats-row {
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .stat-card {
    padding: 20px 24px;
  }

  .stat-val {
    font-size: 26px;
  }

  table.att {
    font-size: 13.5px;
    min-width: 1000px;
  }

  table.att td {
    padding: 16px 14px;
  }

  .today-classes-card {
    padding: 24px 28px;
  }

  .today-row {
    padding: 14px 18px;
  }

  .today-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .footer {
    font-size: 12px;
  }
}

/* ─── Tab-target min 48px on mobile ────────────────────────────────── */
@media (max-width: 767px) {
  .action-btn,
  .tab-btn,
  .nav-item,
  .sheet-nav-item,
  .theme-btn {
    min-height: 48px;
  }

  .action-btn {
    padding: 10px 16px;
    font-size: 13px;
  }

  .tab-btn {
    padding: 12px 18px;
    font-size: 13px;
  }

  #appDashboard.shell {
    padding-bottom: calc(var(--nav-height) + 24px + env(safe-area-inset-bottom, 0));
  }

  .desktop-history-card {
    display: none;
  }

  .footer {
    margin-bottom: 16px;
  }

  .today-classes-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .today-actions {
    width: 100%;
    justify-content: flex-start;
  }
}

/* ─── Simulate Safe Area for modern phones ─────────────────────────── */
@supports (padding: env(safe-area-inset-bottom)) {
  .bottom-nav {
    padding-bottom: env(safe-area-inset-bottom);
    height: calc(var(--nav-height) + env(safe-area-inset-bottom));
  }
}

/* ─── TOOLTIP ────────────────────────────────────────────────────────── */
.tooltip-wrap {
  position: relative;
  display: inline-flex;
}
.tooltip-wrap .tooltip-text {
  visibility: hidden;
  opacity: 0;
  position: absolute;
  bottom: calc(100% + 8px);
  left: 50%;
  transform: translateX(-50%);
  background: var(--surface3);
  border: 1px solid var(--border2);
  border-radius: var(--radius);
  padding: 10px 14px;
  font-size: 12px;
  font-weight: 500;
  color: var(--text);
  white-space: nowrap;
  z-index: 100;
  transition: opacity 0.15s, visibility 0.15s;
  pointer-events: none;
  box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  line-height: 1.6;
  text-align: center;
}
.tooltip-wrap:hover .tooltip-text,
.tooltip-wrap:focus-within .tooltip-text {
  visibility: visible;
  opacity: 1;
}
.tooltip-text .tt-arr { color: var(--text2); }
.tooltip-text .tt-lbl { font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text3); }
.tooltip-text .tt-old { color: var(--text2); }
.tooltip-text .tt-new { font-weight: 700; color: var(--text); }
.tooltip-text .tt-safe { color: var(--green); }
.tooltip-text .tt-unsafe { color: var(--red); }

/* ─── SUBJECT CARD SECTIONS ──────────────────────────────────────────── */
.subj-stat-section + .subj-stat-section { border-top: 1px solid var(--border); padding-top: 12px; margin-top: 4px; }
.subj-stat-section-label { font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text3); margin-bottom: 8px; }

/* ─── HERO CARD ──────────────────────────────────────────────────────── */
.hero-card {
  background: linear-gradient(135deg, var(--surface) 0%, var(--surface2) 100%);
  border: 1px solid var(--accent-glow);
  border-radius: 14px;
  padding: 24px 28px;
  margin-bottom: 24px;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}
.hero-left { display: flex; flex-direction: column; gap: 4px; }
.hero-label { font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text3); }
.hero-title { font-size: 17px; font-weight: 800; color: var(--text); }
.hero-val { font-size: 36px; font-weight: 800; color: var(--text); line-height: 1; letter-spacing: -1px; }
.hero-right { display: flex; gap: 24px; flex-wrap: wrap; }
.hero-item { display: flex; flex-direction: column; gap: 2px; min-width: 100px; }
.hero-item-label { font-size: 10px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text3); }
.hero-item-val { font-size: 18px; font-weight: 700; font-variant-numeric: tabular-nums; }
.hero-item-sub { font-size: 11px; color: var(--text2); }

/* ─── MODE BADGE ──────────────────────────────────────────────────── */
.mode-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-left: 10px;
  padding: 3px 10px;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.08em;
  border-radius: 10px;
  vertical-align: middle;
  animation: badge-pop 0.25s cubic-bezier(0.34,1.56,0.64,1);
}
.mode-live {
  background: var(--green-dim);
  color: var(--green);
  border: 1px solid rgba(74,222,128,0.3);
}
.mode-sim {
  background: var(--amber-dim);
  color: var(--amber);
  border: 1px solid rgba(251,191,36,0.3);
}
@keyframes badge-pop {
  0%   { transform: scale(0.85); opacity: 0; }
  100% { transform: scale(1);    opacity: 1; }
}

/* ─── DATE NAVIGATOR ─────────────────────────────────────────────── */
.today-actions { display: flex; align-items: center; }
.viewing-wrap { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
.viewing-label {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text3);
}

#dateNavigator { position: relative; }

.nav-trigger {
  min-width: 200px;
  justify-content: space-between;
  font-weight: 600;
}
.nav-trigger svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
.nav-trigger .nav-caret { width: 16px; height: 16px; transition: transform var(--transition); }
.nav-trigger[aria-expanded="true"] .nav-caret { transform: rotate(180deg); }

.nav-menu {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  min-width: 220px;
  background: var(--surface);
  border: 1px solid var(--border2);
  border-radius: var(--radius);
  box-shadow: 0 16px 40px rgba(0,0,0,0.35);
  padding: 6px;
  z-index: 200;
  animation: menu-in 0.18s cubic-bezier(0.4,0,0.2,1);
  transform-origin: top right;
}
@keyframes menu-in {
  0%   { opacity: 0; transform: translateY(-6px) scale(0.97); }
  100% { opacity: 1; transform: translateY(0)    scale(1); }
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  padding: 9px 10px;
  background: transparent;
  border: none;
  border-radius: var(--radius-sm);
  color: var(--text);
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  text-align: left;
  transition: var(--transition);
}
.nav-item:hover { background: var(--surface3); }
.nav-item.active { background: var(--accent-dim); color: var(--accent); }
.nav-item-ico { width: 16px; text-align: center; font-size: 11px; color: var(--text2); flex-shrink: 0; }
.nav-item.active .nav-item-ico { color: var(--accent); }
.nav-item-label { flex: 1; }

.nav-item-mode {
  font-size: 8.5px;
  font-weight: 700;
  letter-spacing: 0.06em;
  padding: 2px 7px;
  border-radius: 8px;
  text-transform: uppercase;
}
.nav-mode-live { background: var(--green-dim); color: var(--green); }
.nav-mode-sim  { background: var(--amber-dim); color: var(--amber); }

.nav-sep { height: 1px; background: var(--border); margin: 6px 4px; }

.nav-picker { padding: 6px 4px 4px; }
.nav-picker-label {
  display: block;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text3);
  margin-bottom: 6px;
}
.nav-picker-input {
  width: 100%;
  padding: 9px 10px;
  background: var(--surface2);
  border: 1px solid var(--border2);
  border-radius: var(--radius-sm);
  color: var(--text);
  font-family: inherit;
  font-size: 13px;
  color-scheme: dark;
}
[data-theme="light"] .nav-picker-input { color-scheme: light; }
.nav-picker-input:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

.viewing-date { display: none; }

/* ═══════════════════════════════════════════════════════════════════════
   QUIZ DASHBOARD
   Namespaced 'quiz-' classes. Reuses existing design tokens and utilities.
═══════════════════════════════════════════════════════════════════════ */

/* ─── Quiz status badge variants ──────────────────────────────────── */
.quiz-eligible { background: var(--green-dim); color: var(--green); border: 1px solid rgba(74,222,128,0.2); }
.quiz-needs    { background: var(--amber-dim); color: var(--amber); border: 1px solid rgba(251,191,36,0.2); }
.quiz-na       { background: var(--surface3);  color: var(--text3); border: 1px solid var(--border2); }
.quiz-pending  { background: var(--accent-dim); color: var(--accent); border: 1px solid var(--accent-glow); }

/* ─── Section wrapper ──────────────────────────────────────────────── */
.quiz-dashboard-section {
  margin-bottom: 28px;
}

/* ─── Summary card ─────────────────────────────────────────────────── */
.quiz-summary-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 20px 24px;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
}
.quiz-summary-header {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.quiz-summary-title {
  font-size: 16px;
  font-weight: 700;
  color: var(--text);
  letter-spacing: -0.2px;
}
.quiz-summary-sub {
  font-size: 11px;
  color: var(--text3);
  letter-spacing: 0.05em;
  text-transform: uppercase;
}
.quiz-summary-stats {
  display: flex;
  align-items: center;
  gap: 24px;
}
.quiz-summary-stat {
  text-align: center;
}
.quiz-summary-val {
  font-size: 22px;
  font-weight: 700;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.quiz-summary-label {
  font-size: 10.5px;
  color: var(--text3);
  margin-top: 4px;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

/* ─── Subject grid ─────────────────────────────────────────────────── */
.quiz-subj-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 14px;
}

/* ─── Subject card ─────────────────────────────────────────────────── */
.quiz-subj-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 18px 20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
}
.quiz-subj-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(0,0,0,0.15);
  border-color: var(--accent-glow);
}
.quiz-subj-card--na {
  opacity: 0.7;
}
.quiz-subj-card--na:hover {
  transform: none;
  box-shadow: none;
  border-color: var(--border);
}
.quiz-subj-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.quiz-subj-name {
  font-size: 12px;
  color: var(--text2);
  line-height: 1.4;
  margin-top: -4px;
  border-bottom: 1px solid var(--border);
  padding-bottom: 10px;
}
.quiz-na-message {
  font-size: 12px;
  color: var(--text3);
  font-style: italic;
  line-height: 1.5;
  padding: 6px 0;
}

/* ─── Stats rows inside quiz card ─────────────────────────────────── */
.quiz-subj-stats {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.quiz-pct-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}
.quiz-pct-label {
  font-size: 11px;
  color: var(--text2);
  font-weight: 500;
  white-space: nowrap;
  min-width: 60px;
}
.quiz-pct-na {
  font-size: 12px;
  color: var(--text3);
  font-weight: 500;
}
.quiz-pct-right {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1;
  justify-content: flex-end;
}
.quiz-pct-val {
  font-size: 12px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  min-width: 42px;
  text-align: right;
}
.quiz-pct-track {
  width: 60px;
  height: 5px;
  border-radius: 3px;
  background: var(--surface3);
  overflow: hidden;
  flex-shrink: 0;
}
.quiz-pct-bar {
  height: 100%;
  border-radius: 3px;
  transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ─── Required threshold row ──────────────────────────────────────── */
.quiz-required-row {
  border-top: 1px solid var(--border);
  padding-top: 8px;
  margin-top: 4px;
}
.quiz-required-val {
  font-size: 12px;
  font-weight: 700;
  color: var(--text3);
}

/* ─── Deficit line ─────────────────────────────────────────────────── */
.quiz-deficit {
  font-size: 11.5px;
  color: var(--amber);
  font-weight: 600;
  border-top: 1px solid var(--border);
  padding-top: 10px;
}

/* ─── Responsive: collapse summary to column on narrow screens ───── */
@media (max-width: 600px) {
  .quiz-summary-card {
    flex-direction: column;
    align-items: flex-start;
  }
  .quiz-summary-stats {
    width: 100%;
    justify-content: space-between;
    gap: 12px;
  }
  .quiz-subj-grid {
    grid-template-columns: 1fr;
  }
}
